# Database (pick one)
# Local file DB (default in code if unset):
# DATABASE_URL=sqlite+aiosqlite:///./banking_alm_local.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://alm:alm@localhost:5432/banking_alm

# Comma-separated browser origins allowed to call the API (React dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: comma-separated CIDRs or IPs for future IP allowlists (ingestion gateways)
# INGESTION_ALLOWED_SOURCES=127.0.0.1
